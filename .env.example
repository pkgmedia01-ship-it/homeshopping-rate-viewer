# Local fixtures remain development/test-only. Public deployments use the reviewed read-only dataset explicitly.
LOCAL_SYNTHETIC_MODE=false
PUBLIC_DEMO_MODE=false
GOOGLE_WORKSPACE_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
